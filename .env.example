# Copie para .env e preencha. O .env esta no .gitignore: o repositorio e publico.

# Chave de integridade do requestState do MRTR. Minimo 32 bytes de aleatoriedade.
# Gere a sua com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Nunca versione o valor.
REQUEST_STATE_SECRET=

# Servidor MCP (Streamable HTTP)
MCP_HOST=127.0.0.1
MCP_PORT=7301

# Agente A2A (JSON-RPC)
AGENTE_HOST=127.0.0.1
AGENTE_PORT=7300

# Os caminhos dos endpoints (/mcp e /a2a) ficam de fora de proposito. Eles sao
# fixos no codigo com esses valores e aceitam MCP_PATH / AGENTE_PATH como
# override, mas o Git Bash converte um valor como "/mcp" para um caminho do
# Windows ("C:/Program Files/Git/mcp") ao passa-lo para um processo nativo.
# Quem precisar mudar o caminho no Git Bash deve usar MSYS_NO_PATHCONV=1.

# Endereco do servidor MCP usado pelo agente como host MCP
MCP_URL=http://127.0.0.1:7301/mcp
